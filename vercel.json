{
    "version": 2,
    "name": "iconfont-factory",
    "builds": [
        {
            "src": "font_factory/server.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "line/**",
                    "fill/**",
                    "font_factory/icon-metadata.json",
                    "font_factory/public/**",
                    "frontend/dist/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/font_factory/server.js"
        }
    ]
}
